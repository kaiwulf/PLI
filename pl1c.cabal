cabal-version:      2.4
name:               pl1c
version:            0.1.0.0
synopsis:           Haskell front-end for a PL/I compiler targeting modern GCC
license:            GPL-2.0-only
build-type:         Simple
extra-doc-files:    docs/lessons/*.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat
  build-depends:
      base >=4.15 && <5
    , containers
    , megaparsec >=9
    , mtl
    , parser-combinators
    , prettyprinter
    , text

-- The library stanza (src/, PL1.* modules) is added with the first
-- Phase 0 module, PL1.Loc.

executable pl1c
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs

test-suite spec
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
      hspec
    , hspec-megaparsec
    , tasty-golden
